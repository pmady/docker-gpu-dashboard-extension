{
  "icon": "docker.svg",
  "ui": {
    "dashboard-tab": {
      "title": "GPU Dashboard",
      "root": "/ui",
      "src": "index.html"
    }
  },
  "vm": {
    "image": "${DESKTOP_PLUGIN_IMAGE}"
  },
  "host": {
    "binaries": [
      {
        "darwin": [
          {
            "path": "/darwin/gpu-backend"
          }
        ],
        "linux": [
          {
            "path": "/linux/gpu-backend"
          }
        ],
        "windows": [
          {
            "path": "/windows/gpu-backend.exe"
          }
        ]
      }
    ]
  }
}
